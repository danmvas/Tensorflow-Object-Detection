import cv2

cap = cv2.VideoCapture("rtsp://admin:Prime@itapoa@192.168.5.34:554/Streaming/Channels/1")
cap2 = cv2.VideoCapture("rtsp://admin:Prime@itapoa@192.168.5.48:554/Streaming/Channels/1")

while(True):

    grabbed, frame = cap.read()
    grabbed2, frame2 = cap2.read()

    if grabbed:
        frame = cv2.resize(frame, (1280, 720))
        cv2.imshow('34', frame)
    
    if grabbed2:
        frame2 = cv2.resize(frame2, (1280, 720))
        cv2.imshow('48', frame2)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cap2.release()

cv2.destroyAllWindows() 
